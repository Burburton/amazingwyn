{
  "$schema": "https://opencode.ai/config.json",
  "model": "bailian-coding-plan/glm-5",
  "small_model": "bailian-coding-plan/glm-5",
  "default_agent": "build",
  "instructions": ["AGENTS.md"],
  "autoupdate": true,
  "permission": {
    "edit": "allow",
    "bash": "allow"
  },
  "tools": {
    "write": true,
    "edit": true,
    "bash": true
  },
  "provider": {
    "bailian-coding-plan": {
      "npm": "@ai-sdk/anthropic",
      "name": "Bailian Coding Plan",
      "options": {
        "baseURL": "https://coding.dashscope.aliyuncs.com/apps/anthropic/v1",
        "apiKey": "{env:AMAZINGTEAM_API_KEY}"
      },
      "models": {
        "qwen3.5-plus": {
          "name": "Qwen3.5 Plus",
          "limit": { "context": 1000000, "output": 65536 }
        },
        "glm-5": {
          "name": "GLM-5",
          "limit": { "context": 202752, "output": 16384 }
        }
      }
    }
  }
}
